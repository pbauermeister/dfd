
digraph D {
  graph[label="
- tests/non-regression/120-filter-stray-flow-across-compounds -" fontname="helvetica" fontsize=9 fontcolor="#000060"]
  rankdir=LR
  edge[color=gray fontname="times-italic" fontsize=10]
  node[fontname="helvetica" fontsize=10]

  /* 8: process B */
  "B" [shape=ellipse label="B" fillcolor="#eeeeee" style=filled ]

  /* 9: process C */
  "C" [shape=ellipse label="C" fillcolor="#eeeeee" style=filled ]

  /* 10: process D */
  "D" [shape=ellipse label="D" fillcolor="#eeeeee" style=filled ]

  /* 18: flow C D cd */
  "C" -> "D" [label="cd"]

  /* 9: process Z */
  "Z" [shape=ellipse label="Z" fillcolor="#eeeeee" style=filled ]
}