
digraph D {
  graph[label="
- tests/non-regression/078-filter-replace-two-groups-edge -" fontname="helvetica" fontsize=9 fontcolor="#000060"]
  rankdir=LR
  edge[color=gray fontname="times-italic" fontsize=10]
  node[fontname="helvetica" fontsize=10]

  /* 10: process AB */
  "AB" [shape=ellipse label="AB" fillcolor="#eeeeee" style=filled ]

  /* 11: process CD */
  "CD" [shape=ellipse label="CD" fillcolor="#eeeeee" style=filled ]

  /* 15: flow A C same label */
  "AB" -> "CD" [label="same label"]

  /* 17: flow A D other label */
  "AB" -> "CD" [label="other label"]

  /* 18: flow D B back */
  "CD" -> "AB" [label="back"]
}