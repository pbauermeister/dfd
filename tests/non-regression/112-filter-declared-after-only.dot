
digraph D {
  graph[label="
- tests/non-regression/112-filter-declared-after-only -" fontname="helvetica" fontsize=9 fontcolor="#000060"]
  rankdir=LR
  edge[color=gray fontname="times-italic" fontsize=10]
  node[fontname="helvetica" fontsize=10]

  /* 6: process A */
  "A" [shape=ellipse label="A" fillcolor="#eeeeee" style=filled ]

  /* 8: process B */
  "B" [shape=ellipse label="B" fillcolor="#eeeeee" style=filled ]

  /* 15: flow A B ab */
  "A" -> "B" [label="ab"]

  /* 6: process Z */
  "Z" [shape=ellipse label="Z" fillcolor="#eeeeee" style=filled ]

  /* 7: flow A Z az */
  "A" -> "Z" [label="az"]

  /* 8: frame Z D = F1 */
  subgraph cluster_0 {
    label="F1"
    style=dashed
    "Z"
  }
}