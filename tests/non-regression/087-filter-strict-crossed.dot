
digraph D {
  graph[label="
- tests/non-regression/087-filter-strict-crossed -" fontname="helvetica" fontsize=9 fontcolor="#000060"]
  rankdir=LR
  edge[color=gray fontname="times-italic" fontsize=10]
  node[fontname="helvetica" fontsize=10]

  /* 4: process A */
  "A" [shape=ellipse label="A" fillcolor="#eeeeee" style=filled ]

  /* 5: process B */
  "B" [shape=ellipse label="B" fillcolor="#eeeeee" style=filled ]

  /* 6: process C */
  "C" [shape=ellipse label="C" fillcolor="#eeeeee" style=filled ]

  /* 7: process D */
  "D" [shape=ellipse label="D" fillcolor="#eeeeee" style=filled ]

  /* 9: flow A B ab */
  "A" -> "B" [label="ab"]

  /* 10: flow C D cd */
  "C" -> "D" [label="cd"]
}