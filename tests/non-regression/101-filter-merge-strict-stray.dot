
digraph D {
  graph[label="
- tests/non-regression/101-filter-merge-strict-stray -" fontname="helvetica" fontsize=9 fontcolor="#000060"]
  rankdir=LR
  edge[color=gray fontname="times-italic" fontsize=10]
  node[fontname="helvetica" fontsize=10]

  /* 10: process D */
  "D" [shape=ellipse label="D" fillcolor="#eeeeee" style=filled ]

  /* 12: process G Group */
  "G" [shape=ellipse label="Group" fillcolor="#eeeeee" style=filled ]

  /* 18: flow C D cd */
  "G" -> "D" [label="cd"]

  /* 5: process X */
  "X" [shape=ellipse label="X" fillcolor="#eeeeee" style=filled ]
}