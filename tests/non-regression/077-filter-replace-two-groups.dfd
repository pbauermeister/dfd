# Issue #100: flows between two replaced groups must be rewired
# between their replacers (AB -> CD, AB <- CD), not dropped.
# Labels ride along with the rewired flows.

process A
process B

process C
process D

process E

A -> C  a to c
A -> E  a to e

B <- D  d to b
D -> E  d to e

process AB
~=AB A B

process CD
~=CD C D
