
digraph D {
  graph[label="
- tests/non-regression/079-filter-replace-self-loop -" fontname="helvetica" fontsize=9 fontcolor="#000060"]
  rankdir=LR
  edge[color=gray fontname="times-italic" fontsize=10]
  node[fontname="helvetica" fontsize=10]

  /* 8: process E */
  "E" [shape=ellipse label="E" fillcolor="#eeeeee" style=filled ]

  /* 9: process AB */
  "AB" [shape=ellipse label="AB" fillcolor="#eeeeee" style=filled ]

  /* 14: flow E E genuine self-loop */
  "E" -> "E" [label="genuine self-\nloop"]

  /* 15: flow A E out of the group */
  "AB" -> "E" [label="out of the\ngroup"]
}