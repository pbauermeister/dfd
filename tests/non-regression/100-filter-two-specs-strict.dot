
digraph D {
  graph[label="
- tests/non-regression/100-filter-two-specs-strict -" fontname="helvetica" fontsize=9 fontcolor="#000060"]
  rankdir=LR
  edge[color=gray fontname="times-italic" fontsize=10]
  node[fontname="helvetica" fontsize=10]

  /* 16: entity E2 Entity 2 */
  "E2" [shape=rectangle label="Entity 2" ]

  /* 19: process P2 Process 2 */
  "P2" [shape=ellipse label="Process 2" fillcolor="#eeeeee" style=filled ]

  /* 22: process P5 Process 5 */
  "P5" [shape=ellipse label="Process 5" fillcolor="#eeeeee" style=filled ]

  /* 26: store S2 Store 2 */
  "S2" [shape=none label=<
    <TABLE BORDER="0">
      <TR><TD BGCOLOR="black" WIDTH="6"></TD></TR>
      <TR><TD><FONT COLOR="black">Store 2</FONT></TD></TR>
      <TR><TD BGCOLOR="black" WIDTH="6"></TD></TR>
    </TABLE>>]

  /* 28: channel C1 Channel 1 */
  "C1" [shape=none label=<
    <TABLE BORDER="0">
      <TR>
        <TD WIDTH="48"></TD>
        <TD BGCOLOR="black" WIDTH="0" PORT="x"><BR/><BR/></TD>
        <TD WIDTH="48"></TD>
      </TR>
      <TR>
        <TD COLSPAN="3"><FONT COLOR="black">Channel 1</FONT></TD>
      </TR>
    </TABLE>>]

  /* 29: channel C2 Channel 2 */
  "C2" [shape=none label=<
    <TABLE BORDER="0">
      <TR>
        <TD WIDTH="48"></TD>
        <TD BGCOLOR="black" WIDTH="0" PORT="x"><BR/><BR/></TD>
        <TD WIDTH="48"></TD>
      </TR>
      <TR>
        <TD COLSPAN="3"><FONT COLOR="black">Channel 2</FONT></TD>
      </TR>
    </TABLE>>]

  /* 31: frame C2 C1 S2 = Frame 1 */
  subgraph cluster_0 {
    label="Frame 1"
    style=dashed
    "C2"
    "C1"
    "S2"
  }

  /* 32: frame P4 P5 = Frame 2 */
  subgraph cluster_1 {
    label="Frame 2"
    style=dashed
    "P5"
  }

  /* 38: flow P2 C2 f4 */
  "P2" -> "C2":x:c [label="f4"]

  /* 39: flow.r P2 S2 f5 */
  "P2" -> "S2" [label="f5" dir=back]

  /* 40: signal P2 E2 f6 */
  "P2" -> "E2" [label="f6" style=dashed]

  /* 45: flow S2 P5 f9 */
  "S2" -> "P5" [label="f9"]

  /* 46: flow.r C1 P5 f10 */
  "C1":x:c -> "P5" [label="f10" dir=back]
}