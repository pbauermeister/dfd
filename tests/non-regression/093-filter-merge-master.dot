
digraph D {
  graph[label="
- tests/non-regression/093-filter-merge-master -" fontname="helvetica" fontsize=9 fontcolor="#000060"]
  rankdir=LR
  edge[color=gray fontname="times-italic" fontsize=10]
  node[fontname="helvetica" fontsize=10]

  /* 6: process A */
  "A" [shape=ellipse label="A" fillcolor="#eeeeee" style=filled ]

  /* 7: process E */
  "E" [shape=ellipse label="E" fillcolor="#eeeeee" style=filled ]

  /* 8: process B */
  "B" [shape=ellipse label="B" fillcolor="#eeeeee" style=filled ]

  /* 9: process C */
  "C" [shape=ellipse label="C" fillcolor="#eeeeee" style=filled ]

  /* 10: process D */
  "D" [shape=ellipse label="D" fillcolor="#eeeeee" style=filled ]

  /* 11: process F */
  "F" [shape=ellipse label="F" fillcolor="#eeeeee" style=filled ]

  /* 12: process G Group */
  "G" [shape=ellipse label="Group" fillcolor="#eeeeee" style=filled ]

  /* 13: process H Super */
  "H" [shape=ellipse label="Super" fillcolor="#eeeeee" style=filled ]

  /* 15: flow A B ab */
  "A" -> "B" [label="ab"]

  /* 16: flow E B eb */
  "E" -> "B" [label="eb"]

  /* 17: flow B C bc */
  "B" -> "C" [label="bc"]

  /* 18: flow C D cd */
