
digraph D {
  graph[label="
- tests/non-regression/099-filter-merge-chain -" fontname="helvetica" fontsize=9 fontcolor="#000060"]
  rankdir=LR
  edge[color=gray fontname="times-italic" fontsize=10]
  node[fontname="helvetica" fontsize=10]

  /* 6: process A */
  "A" [shape=ellipse label="A" fillcolor="#eeeeee" style=filled ]

  /* 7: process E */
  "E" [shape=ellipse label="E" fillcolor="#eeeeee" style=filled ]

  /* 11: process F */
  "F" [shape=ellipse label="F" fillcolor="#eeeeee" style=filled ]

  /* 13: process H Super */
  "H" [shape=ellipse label="Super" fillcolor="#eeeeee" style=filled ]

  /* 15: flow A B ab */
  "A" -> "H" [label="ab"]

  /* 16: flow E B eb */
  "E" -> "H" [label="eb"]

  /* 19: flow D F df */
  "H" -> "F" [label="df"]
}